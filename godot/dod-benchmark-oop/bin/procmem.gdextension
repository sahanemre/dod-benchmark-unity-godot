[configuration]
entry_symbol = "procmem_library_init"
compatibility_minimum = "4.4"

[libraries]
windows.debug.x86_64 = "res://bin/libprocmem.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libprocmem.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libprocmem.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libprocmem.linux.template_release.x86_64.so"
