#!/usr/bin/env python
import os

# godot-cpp build ortamini yukler (platform/arch/target bayraklarini saglar).
# godot-cpp, bu dosyanin yaninda submodule olarak bulunmali:
#   git submodule add -b 4.6 https://github.com/godotengine/godot-cpp godot-cpp
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

libname = "movementdod"
# Cikti dogrudan Godot projesinin bin/ klasorune yazilir; .gdextension oradan okur.
bindir = "demo/bin"

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "{}/lib{}.{}.{}.framework/{}.{}.{}".format(
            bindir, libname, env["platform"], env["target"],
            libname, env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "{}/lib{}{}{}".format(bindir, libname, env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

targets = [library]

# --- procmem: OS duzeyi bellek olcum eklentisi (iki Godot projesinin ortagi) --
# Kaynaklar godot/procmem/src altinda. godot-cpp tek kez derlensin diye burada
# ikinci bir kutuphane olarak derlenir; movementdod'u ETKILEMEZ. Cikti hem bu
# projenin demo/bin'ine hem Godot OOP projesinin bin/'ine konur.
if env["platform"] != "macos":
    env_pm = env.Clone()
    env_pm.Append(CPPPATH=["../procmem/src/"])
    if env["platform"] == "windows":
        # GetProcessMemoryInfo (psapi). Yeni SDK'larda kernel32'ye yonlenir;
        # eski SDK/MinGW icin kutuphane acikca eklenir.
        env_pm.Append(LIBS=["psapi"])
    procmem = env_pm.SharedLibrary(
        "{}/libprocmem{}{}".format(bindir, env["suffix"], env["SHLIBSUFFIX"]),
        source=Glob("../procmem/src/*.cpp"),
    )
    # MSVC .lib/.exp da uretir; yalnizca paylasimli kutuphaneyi kopyala
    procmem_shlib = [n for n in procmem if str(n).endswith(env["SHLIBSUFFIX"])]
    targets += [procmem, env_pm.Install("../dod-benchmark-oop/bin", procmem_shlib)]

Default(targets)
